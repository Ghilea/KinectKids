<Window x:Class="KinectKids.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rörelselek för Kinect" MinWidth="960" MinHeight="640"
        Width="1280" Height="800" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" Background="#14213D"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10213D" Offset="0" />
            <GradientStop Color="#183B59" Offset="0.48" />
            <GradientStop Color="#315B72" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="15,9" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,22,28,10" Panel.ZIndex="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="14" Background="#FF6B5A" Margin="0,0,13,0">
                    <TextBlock Text="K" Foreground="White" FontSize="25" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="RÖRELSELEK" Foreground="White" FontWeight="Bold" FontSize="22" />
                    <TextBlock Text="för Kinect 360" Foreground="#BFE8F4" FontSize="13" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="SensorBadge" Background="#3324D49A" CornerRadius="16" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SensorDot" Width="10" Height="10" Fill="#50E3A4" Margin="0,0,8,0" />
                        <TextBlock x:Name="SensorText" Text="Letar efter Kinect…" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Button x:Name="FullscreenButton" Content="Helskärm" Style="{StaticResource SmallButton}" Click="FullscreenButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="HomePanel" Grid.Row="1" Margin="28,8,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="42,0,55,30">
                <Border Background="#29FFFFFF" CornerRadius="14" Padding="14,7" HorizontalAlignment="Left" Margin="0,0,0,22">
                    <TextBlock Text="1–2 SPELARE • HELA KROPPEN" Foreground="#D4F4FA" FontWeight="Bold" FontSize="13" />
                </Border>
                <TextBlock Text="Hoppa in och&#x0a;smäll ballonger!" Foreground="White" FontSize="58" FontWeight="Black" LineHeight="62" />
                <TextBlock Text="Ett enkelt rörelsespel där barnen använder händerna.&#x0a;Ingen handkontroll behövs och ingen kamerabild sparas." Foreground="#DCECF4" FontSize="20" LineHeight="30" Margin="0,20,0,28" />
                <WrapPanel>
                    <Button Content="Starta spelet" Click="StartButton_Click" Margin="0,0,14,12" />
                    <Button x:Name="InputModeButton" Content="Testa med mus" Click="MouseModeButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12" />
                </WrapPanel>
                <TextBlock Text="Tips: stå 1,5–3 meter från sensorn. Tryck Esc för att gå tillbaka." Foreground="#9FC8D8" FontSize="14" Margin="2,8,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="40" BorderBrush="#35FFFFFF" BorderThickness="1" Margin="18">
                <Grid ClipToBounds="True">
                    <Ellipse Width="460" Height="460" Fill="#18FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="330" Height="330" Fill="#18FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Canvas Width="440" Height="470" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="100" Height="114" Fill="#FFBE47" Canvas.Left="48" Canvas.Top="62" />
                        <Line X1="98" Y1="175" X2="92" Y2="226" Stroke="#FFBE47" StrokeThickness="5" />
                        <Ellipse Width="85" Height="96" Fill="#57D5A7" Canvas.Left="286" Canvas.Top="35" />
                        <Line X1="328" Y1="130" X2="334" Y2="188" Stroke="#57D5A7" StrokeThickness="5" />
                        <Ellipse Width="76" Height="86" Fill="#FF5B77" Canvas.Left="320" Canvas.Top="280" />
                        <Line X1="358" Y1="364" X2="349" Y2="418" Stroke="#FF5B77" StrokeThickness="5" />
                        <Ellipse Width="66" Height="75" Fill="#5EAEFF" Canvas.Left="24" Canvas.Top="305" />
                        <Line X1="57" Y1="378" X2="64" Y2="430" Stroke="#5EAEFF" StrokeThickness="5" />

                        <Ellipse Width="80" Height="80" Fill="#F4C7A1" Canvas.Left="180" Canvas.Top="65" />
                        <Line X1="220" Y1="145" X2="220" Y2="290" Stroke="White" StrokeThickness="28" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="215" Y1="185" X2="115" Y2="117" Stroke="#AEEAFA" StrokeThickness="23" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="225" Y1="185" X2="328" Y2="88" Stroke="#AEEAFA" StrokeThickness="23" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="214" Y1="280" X2="164" Y2="405" Stroke="#6FBCFF" StrokeThickness="26" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="226" Y1="280" X2="285" Y2="405" Stroke="#6FBCFF" StrokeThickness="26" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Width="39" Height="39" Fill="#FF6B5A" Canvas.Left="95" Canvas.Top="97" />
                        <Ellipse Width="39" Height="39" Fill="#FF6B5A" Canvas.Left="310" Canvas.Top="68" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="CalibrationPanel" Grid.Row="1" Visibility="Collapsed" Margin="35,0,35,35">
            <Border Background="#22FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="34" Padding="35">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Ställ er framför kameran" Foreground="White" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CalibrationStatus" Text="Vi väntar tills Kinect ser minst en spelare…" Foreground="#C9E6F1" FontSize="19" Margin="0,9,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Canvas x:Name="CalibrationCanvas" Grid.Row="1" Background="Transparent" Margin="10" ClipToBounds="True">
                        <Ellipse x:Name="PlayerOneReady" Width="170" Height="170" Fill="#245EAEFF" Stroke="#5EAEFF" StrokeThickness="4" Visibility="Collapsed" />
                        <Ellipse x:Name="PlayerTwoReady" Width="170" Height="170" Fill="#24FF7694" Stroke="#FF7694" StrokeThickness="4" Visibility="Collapsed" />
                    </Canvas>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ContinueButton" Content="Kör igång!" Click="ContinueButton_Click" IsEnabled="False" Opacity="0.45" Margin="0,0,14,0" />
                        <Button Content="Tillbaka" Click="HomeButton_Click" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="GamePanel" Grid.RowSpan="2" Visibility="Collapsed" Background="#10213D" Panel.ZIndex="30">
            <Canvas x:Name="Playfield" Background="#102B46" ClipToBounds="True" />

            <Grid VerticalAlignment="Top" Margin="28,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#D9223A59" CornerRadius="20" Padding="20,12" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="18" Height="18" Fill="#5EAEFF" Margin="0,0,9,0" />
                        <TextBlock Text="SPELARE 1  " Foreground="#BFE6FF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlayerOneScore" Text="0" Foreground="White" FontWeight="Black" FontSize="27" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#EFFFFFFF" CornerRadius="25" Padding="25,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TID  " Foreground="#45637A" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TimeText" Text="60" Foreground="#14213D" FontSize="31" FontWeight="Black" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" x:Name="PlayerTwoScoreBox" Background="#D9223A59" CornerRadius="20" Padding="20,12" HorizontalAlignment="Right" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="18" Height="18" Fill="#FF7694" Margin="0,0,9,0" />
                        <TextBlock Text="SPELARE 2  " Foreground="#FFD6DF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlayerTwoScore" Text="0" Foreground="White" FontWeight="Black" FontSize="27" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button x:Name="PauseButton" Content="Paus" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,22" Click="PauseButton_Click" />

            <Border x:Name="CountdownOverlay" Background="#D914213D" Visibility="Collapsed">
                <TextBlock x:Name="CountdownText" Text="3" Foreground="White" FontSize="160" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border x:Name="PauseOverlay" Background="#D914213D" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Paus" Foreground="White" FontSize="58" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,28" />
                    <Button Content="Fortsätt" Click="PauseButton_Click" Margin="0,0,0,14" />
                    <Button Content="Avsluta rundan" Click="HomeButton_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>

            <Border x:Name="ResultOverlay" Background="#EB14213D" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420">
                    <TextBlock Text="Bra jobbat!" Foreground="#FFCF5A" FontSize="58" FontWeight="Black" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ResultText" Text="Ni fick 0 poäng" Foreground="White" FontSize="29" HorizontalAlignment="Center" Margin="0,14,0,34" />
                    <Button Content="Spela igen" Click="ReplayButton_Click" Margin="0,0,0,14" />
                    <Button Content="Till startsidan" Click="HomeButton_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
