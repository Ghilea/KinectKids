<Window x:Class="KinectKids.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KinectKids.Controls"
        Title="Rörelselek för Kinect" MinWidth="960" MinHeight="640"
        Width="1280" Height="800" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" Background="#14213D"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10213D" Offset="0" />
            <GradientStop Color="#183B59" Offset="0.48" />
            <GradientStop Color="#315B72" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="15,9" />
        </Style>
        <Style x:Key="HomeGameButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="CarouselButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="292" />
            <Setter Property="Height" Value="68" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Background="#080D22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" Fill="#322D6BFF" Canvas.Left="-330" Canvas.Top="-250">
                <Ellipse.Effect><BlurEffect Radius="70" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="620" Height="620" Fill="#2BE74B91" Canvas.Right="-240" Canvas.Top="90">
                <Ellipse.Effect><BlurEffect Radius="85" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="480" Height="480" Fill="#1D28D6B0" Canvas.Left="390" Canvas.Bottom="-260">
                <Ellipse.Effect><BlurEffect Radius="75" /></Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Grid Grid.Row="0" Margin="28,22,28,10" Panel.ZIndex="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="14" Background="#FF6B5A" Margin="0,0,13,0">
                    <TextBlock Text="K" Foreground="White" FontSize="25" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="RÖRELSELEK" Foreground="White" FontWeight="Bold" FontSize="22" />
                    <TextBlock Text="för Kinect 360" Foreground="#BFE8F4" FontSize="13" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="SensorBadge" Background="#3324D49A" CornerRadius="16" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SensorDot" Width="10" Height="10" Fill="#50E3A4" Margin="0,0,8,0" />
                        <TextBlock x:Name="SensorText" Text="Letar efter Kinect…" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Button x:Name="CameraModeButton" Content="Bild: kamera" Style="{StaticResource SmallButton}" Click="CameraModeButton_Click" Margin="0,0,10,0" />
                <Button x:Name="MenuMusicButton" Content="♫ Musik: på" Style="{StaticResource SmallButton}" Click="MenuMusicButton_Click" Margin="0,0,10,0" />
                <Button x:Name="FullscreenButton" Content="Helskärm" Style="{StaticResource SmallButton}" Click="FullscreenButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="HomePanel" Grid.Row="1" Margin="28,8,28,28" PreviewMouseWheel="HomePanel_MouseWheel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,6,18,6" Background="#B0101732" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="34" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="28,18,0,0">
                        <TextBlock Text="VÄLJ SPEL" Foreground="#FFCF5A" FontWeight="Black" FontSize="14" />
                        <TextBlock Text="Dra handen upp eller ned" Foreground="#AFCDE1" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                    <Canvas x:Name="GameCarousel" Grid.Row="1" ClipToBounds="True">
                        <Button x:Name="MathStartButton" Content="➕  Matematikbanan" Click="MathStartButton_Click" Style="{StaticResource CarouselButton}" Background="#2AA878" />
                        <Button x:Name="SwedishStartButton" Content="Å  Bokstavsjakten" Click="SwedishStartButton_Click" Style="{StaticResource CarouselButton}" Background="#D94F70" />
                        <Button x:Name="ShapeStartButton" Content="◆  Formverkstan" Click="ShapeStartButton_Click" Style="{StaticResource CarouselButton}" Background="#E4962E" />
                        <Button x:Name="PatternStartButton" Content="◉  Mönsterjakten" Click="PatternStartButton_Click" Style="{StaticResource CarouselButton}" Background="#3184C6" />
                        <Button x:Name="SimonStartButton" Content="★  Simon säger" Click="SimonStartButton_Click" Style="{StaticResource CarouselButton}" Background="#3978D4" />
                        <Button x:Name="BalloonStartButton" Content="●  Ballongjakten" Click="StartButton_Click" Style="{StaticResource CarouselButton}" Background="#E85768" />
                        <Button x:Name="SpookyAdventureButton" Content="☾  Spökjakten" Click="SpookyAdventureButton_Click" Style="{StaticResource CarouselButton}" Background="#6741A5" />
                        <Button x:Name="GreveGastButton" Content="✎  Greve Gasts Jakt" Click="GreveGastButton_Click" Style="{StaticResource CarouselButton}" Background="#8A2FB0" />
                    </Canvas>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="▲" Style="{StaticResource SmallButton}" Click="CarouselUpButton_Click" Margin="0,0,10,0" />
                        <Button Content="▼" Style="{StaticResource SmallButton}" Click="CarouselDownButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#C5101732" CornerRadius="40" BorderBrush="#45FFFFFF" BorderThickness="1" Margin="0,6,0,6" ClipToBounds="True">
                <Grid ClipToBounds="True">
                    <Border x:Name="PreviewTint" Background="#A52A7A64" />
                    <Ellipse Width="540" Height="540" Fill="#16FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-100,0" />
                    <Grid Margin="54,44">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="#28FFFFFF" CornerRadius="14" Padding="14,7" HorizontalAlignment="Left">
                            <TextBlock x:Name="PreviewCategory" Text="PEDAGOGISKT • 1–2 SPELARE" Foreground="#D7F4FF" FontWeight="Bold" FontSize="13" />
                        </Border>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="PreviewGlyph" Text="2 + 3" Foreground="#26FFFFFF" FontWeight="Black" FontSize="145" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" MaxWidth="590" HorizontalAlignment="Left">
                                <TextBlock x:Name="PreviewTitle" Text="Matematikbanan" Foreground="White" FontSize="52" FontWeight="Black" TextWrapping="Wrap" />
                                <TextBlock x:Name="PreviewDescription" Text="Räkna tillsammans och slå på ballongen med rätt svar." Foreground="#E2EEF5" FontSize="22" LineHeight="31" TextWrapping="Wrap" Margin="0,18,0,22" />
                                <Border Background="#D9FFFFFF" CornerRadius="18" Padding="18,12" HorizontalAlignment="Left">
                                    <TextBlock x:Name="PreviewAction" Text="HÅLL HANDEN ÖVER SPELET FÖR ATT STARTA" Foreground="#152743" FontWeight="Black" FontSize="14" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <StackPanel>
                                <TextBlock x:Name="ProgressText" Text="Alla spel är tillgängliga." Foreground="#FFDB75" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Menyn loopar automatiskt • båda händerna fungerar" Foreground="#9FC8D8" FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="CalibrationPanel" Grid.Row="1" Visibility="Collapsed" Margin="35,0,35,35">
            <Border Background="#22FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="34" Padding="35">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="CalibrationTitle" Text="Ställ er framför kameran" Foreground="White" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CalibrationStatus" Text="Vi väntar tills Kinect ser minst en spelare…" Foreground="#C9E6F1" FontSize="19" Margin="0,9,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="De stora färgade ringarna är dina händer." Foreground="#FFCF5A" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="10" ClipToBounds="True">
                        <Image x:Name="CalibrationCameraImage" Stretch="UniformToFill" Opacity="0.78" Visibility="Collapsed" />
                        <Canvas x:Name="CalibrationSkeletonCanvas" Background="Transparent" />
                        <Canvas x:Name="CalibrationCanvas" Background="Transparent">
                            <Ellipse x:Name="PlayerOneLeftHand" Width="72" Height="72" Fill="#CC5EAEFF" Stroke="#FFFFFF" StrokeThickness="5" Visibility="Collapsed" />
                            <Ellipse x:Name="PlayerOneRightHand" Width="72" Height="72" Fill="#CC5EAEFF" Stroke="#FFFFFF" StrokeThickness="5" Visibility="Collapsed" />
                            <Ellipse x:Name="PlayerTwoLeftHand" Width="72" Height="72" Fill="#CCFF7694" Stroke="#FFFFFF" StrokeThickness="5" Visibility="Collapsed" />
                            <Ellipse x:Name="PlayerTwoRightHand" Width="72" Height="72" Fill="#CCFF7694" Stroke="#FFFFFF" StrokeThickness="5" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ContinueButton" Content="Kör igång!" Click="ContinueButton_Click" IsEnabled="False" Opacity="0.45" Margin="0,0,14,0" />
                        <Button Content="Tillbaka" Click="HomeButton_Click" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="GamePanel" Grid.RowSpan="2" Visibility="Collapsed" Background="#10213D" Panel.ZIndex="30">
            <Border x:Name="BalloonBackdrop" Background="#102B46">
                <Grid>
                    <Image x:Name="GameBackgroundImage" Source="Assets/learning-game-background.png" Stretch="UniformToFill" />
                    <Border x:Name="GameThemeTint" Background="#66102B46" />
                    <Border Background="#28071324" />
                </Grid>
            </Border>
            <Image x:Name="PlayerCameraImage" Stretch="UniformToFill" Opacity="0.72" Visibility="Collapsed" IsHitTestVisible="False" />
            <Canvas x:Name="GameSkeletonCanvas" Background="Transparent" ClipToBounds="True" IsHitTestVisible="False" Opacity="0.52" />
            <Canvas x:Name="Playfield" Background="Transparent" ClipToBounds="True" />

            <Border x:Name="GameInstruction" Background="#DAFFFFFF" CornerRadius="18" Padding="22,11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,104,0,0" Panel.ZIndex="8">
                <TextBlock x:Name="GameInstructionText" Text="De färgade ringarna är dina händer – rör en ring in i en ballong!" Foreground="#17324A" FontSize="18" FontWeight="Bold" />
            </Border>

            <Border x:Name="BossBanner" Visibility="Collapsed" Background="#E58B55D9" CornerRadius="18" Padding="24,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Panel.ZIndex="9">
                <TextBlock Text="BOSS: ZOMBIEKONDUKTÖREN!" Foreground="White" FontSize="21" FontWeight="Black" />
            </Border>

            <Grid VerticalAlignment="Top" Margin="28,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#D9223A59" CornerRadius="20" Padding="20,12" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="18" Height="18" Fill="#5EAEFF" Margin="0,0,9,0" />
                        <TextBlock Text="SPELARE 1  " Foreground="#BFE6FF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlayerOneScore" Text="0" Foreground="White" FontWeight="Black" FontSize="27" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#EFFFFFFF" CornerRadius="25" Padding="25,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TID  " Foreground="#45637A" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TimeText" Text="60" Foreground="#14213D" FontSize="31" FontWeight="Black" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" x:Name="PlayerTwoScoreBox" Background="#D9223A59" CornerRadius="20" Padding="20,12" HorizontalAlignment="Right" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="18" Height="18" Fill="#FF7694" Margin="0,0,9,0" />
                        <TextBlock Text="SPELARE 2  " Foreground="#FFD6DF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlayerTwoScore" Text="0" Foreground="White" FontWeight="Black" FontSize="27" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="CountdownOverlay" Background="#D914213D" Visibility="Collapsed">
                <TextBlock x:Name="CountdownText" Text="3" Foreground="White" FontSize="160" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border x:Name="ResultOverlay" Background="#EB14213D" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420">
                    <TextBlock Text="Bra jobbat!" Foreground="#FFCF5A" FontSize="58" FontWeight="Black" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ResultText" Text="Ni fick 0 poäng" Foreground="White" FontSize="29" HorizontalAlignment="Center" Margin="0,14,0,34" />
                    <Button Content="Spela igen" Click="ReplayButton_Click" Margin="0,0,0,14" />
                    <Button Content="Till startsidan" Click="HomeButton_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>

            <controls:GameSessionMenu x:Name="SessionMenu" Panel.ZIndex="1800"
                                      Opened="SessionMenu_Opened"
                                      ContinueRequested="SessionMenu_ContinueRequested"
                                      RestartRequested="SessionMenu_RestartRequested"
                                      HomeRequested="SessionMenu_HomeRequested" />
        </Grid>

        <Canvas x:Name="KinectMenuCanvas" Grid.RowSpan="2" Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="200">
            <Grid x:Name="MenuHandIndicator" Width="82" Height="98" Visibility="Collapsed">
                <Ellipse Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#DD5EAEFF" Stroke="White" StrokeThickness="5" />
                <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,23,0,0" Fill="White" />
                <Border Width="74" Height="10" VerticalAlignment="Bottom" CornerRadius="5" Background="#55FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <Border x:Name="MenuDwellProgress" Width="0" HorizontalAlignment="Left" Background="#FFCF5A" CornerRadius="4" />
                    </Grid>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</Window>
