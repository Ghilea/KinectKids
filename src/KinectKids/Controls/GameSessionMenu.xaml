<UserControl x:Class="KinectKids.Controls.GameSessionMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Button x:Name="OpenButton" Content="☰ SPELMENY" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,25,22" FontSize="15" Padding="16,10" Click="OpenButton_Click" />
        <Border x:Name="Overlay" Background="#EA080D22" Visibility="Collapsed">
            <Border Width="480" Padding="42" CornerRadius="34" Background="#F0182947"
                    BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="SPELMENY" Foreground="#FFCF5A" FontSize="42" FontWeight="Black" HorizontalAlignment="Center" />
                    <TextBlock Text="Vad vill ni göra?" Foreground="#CBE7F2" FontSize="18" HorizontalAlignment="Center" Margin="0,7,0,28" />
                    <Button Content="Fortsätt spela" Click="ContinueButton_Click" Margin="0,0,0,13" />
                    <Button Content="Starta om spelet" Click="RestartButton_Click" Background="#3978D4" Margin="0,0,0,13" />
                    <Button Content="Till gemensamma menyn" Click="HomeButton_Click" Background="#D94F70" />
                    <TextBlock Text="Håll handen över ett val" Foreground="#9FC8D8" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
